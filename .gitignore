# Raw data stays local. Only the canonical derived prediction outputs below are tracked.
data/
*.csv
!results/**/*.csv
*.parquet
*.pkl
*.npz
*.npy
*.h5
*.tflite
*.pt
*.ckpt

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# OS / editors
.DS_Store
.vscode/
.idea/

# Keep only the current-default NAB predictions; other generated outputs stay local.
outputs/*
!outputs/predictions/
outputs/predictions/*
!outputs/predictions/*/
!outputs/predictions/*.csv
!outputs/predictions/*/*.csv
!outputs/predictions/summary.json
